function first(value: number): number {
  const next = value + 1;
  const two = next + 2;
  const three = two + 3;
  const four = three + 4;
  const five = four + 5;
  const six = five + 6;
  const seven = six + 7;
  const eight = seven + 8;
  return eight + "one".length;
}

function second(input: number): number {
  const result = input + 1;
  const two = result + 2;
  const three = two + 3;
  const four = three + 4;
  const five = four + 5;
  const six = five + 6;
  const seven = six + 7;
  const eight = seven + 8;
  return eight + "two".length;
}

function third(total: number): number {
  const amount = total + 1;
  const two = amount + 2;
  const three = two + 3;
  const four = three + 4;
  const five = four + 5;
  const six = five + 6;
  const seven = six + 7;
  const eight = seven + 8;
  return eight + "three".length;
}
