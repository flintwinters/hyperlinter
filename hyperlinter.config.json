{
  "rules": {
    "dependencyCycles": "error",
    "unusedPublicSurface": "smell",
    "couplingOutliers": "smell",
    "exactDuplicates": "smell",
    "nearDuplicates": "info",
    "publicSurfaceGrowth": "smell",
    "publicSurfaceLimit": "error",
    "moduleEntrypoint": "error",
    "singlePublicMethod": "error",
    "moduleScore": "error"
  },
  "clones": {
    "exactMinimumMeaningfulNodes": 20,
    "nearMinimumMeaningfulNodes": 15,
    "nearMinimumSimilarity": 0.9,
    "nearMinimumClusterMethods": 3,
    "nearMinimumSharedSubtreeHashes": 3
  },
  "coupling": {
    "minimumOutlierValue": 3,
    "minimumZScore": 2
  },
  "publicSurface": {
    "maximum": 40
  },
  "scoring": {
    "severityWeights": {
      "error": 4,
      "smell": 2,
      "info": 1
    },
    "moduleErrorThreshold": 4
  }
}
