{
  "name": "hyperlinter",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-scale TypeScript architecture linter",
  "type": "module",
  "scripts": {
    "hyperlint": "node --import tsx src/cli.ts",
    "baseline": "tsx src/cli.ts --write-baseline",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/chronology/*.test.ts tests/runtime/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "css-tree": "^3.2.1",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/stylex": "^0.19.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22"
  }
}
